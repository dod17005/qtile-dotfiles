[global]
corner_radius=10
font="Monospace 10"
frame_width=2
horizontal_padding=10
max_icon_size=128
padding=10
icon_theme = "char-white"
enable_recursive_icon_lookup = true

[urgency_critical]
background="#292e42" # <- this looks bad
foreground="#db4b4b"
frame_color="#db4b4b"

[urgency_low]
background="#16161e"
foreground="#c0caf5"
frame_color="#c0caf5"

[urgency_normal]
background="#1a1b26"
foreground="#c0caf5"
frame_color="#c0caf5"
